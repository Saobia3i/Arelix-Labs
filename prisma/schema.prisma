// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String?  // e.g. "contact-form", "assistant", "cta"
  createdAt DateTime @default(now())
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String?
  messages  Json
  createdAt DateTime @default(now())
}

model Content {
  id        String   @id @default(cuid())
  section   String   @unique // e.g. "services", "selectedWork"
  data      Json
  updatedAt DateTime @updatedAt
}
